# Server config for the Tag Trace collector -> /etc/tagtrace/tagtrace.env
# sudo install -m 600 -o tagtrace -g tagtrace tagtrace.env.example /etc/tagtrace/tagtrace.env
# Then fill in the values. Never commit the filled-in file.

# Neon connection string (SECRET). Plain postgresql:// is accepted.
DATABASE_URL=

# Encrypts every user's Google credentials in the DB (SECRET). Generate with
#   .venv/bin/python collector.py --generate-key
TAG_CREDENTIALS_KEY=

# Optional one-time import of the old single-tag setup for this user.
LEGACY_TAG_OWNER=
# Old secrets.json copied from your Mac (SECRET, chmod 600); only read once.
GFMT_SECRETS_FILE=/etc/tagtrace/secrets.json

TAG_NAME=Tag
POLL_INTERVAL=300
# Only Caddy talks to the collector; keep it off the public interface.
HTTP_HOST=127.0.0.1
HTTP_PORT=8020
SESSION_TTL_DAYS=7
