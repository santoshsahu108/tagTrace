# Tag Trace collector configuration.
# Copy this file to `.env` and adjust. Real environment variables, if set,
# always override these. `.env` is gitignored; `.env.example` is committed.

# --- Database ---------------------------------------------------------------
# Option A: a full SQLAlchemy URL (takes precedence over the PG* parts below).
# Use this for a managed cloud Postgres such as Neon (free tier, SSL required).
# Copy the connection string from your provider and keep sslmode=require:
# Plain postgresql:// (as `neon env pull` writes it) also works.
#   DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Option B: granular parts (used only when DATABASE_URL is empty). These match
# a local Postgres.app's trust-auth defaults, so a password is usually not
# needed. Ignored entirely when DATABASE_URL is set.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=tagtrace

# --- Collector --------------------------------------------------------------
TAG_NAME=Tag          # substring of your tracker's name in Find Hub
POLL_INTERVAL=300     # seconds between fetches
HTTP_HOST=0.0.0.0     # 127.0.0.1 on a server behind a reverse proxy
HTTP_PORT=8020        # port the Android app + web UI connect to
SESSION_TTL_DAYS=7    # how long a login stays valid

# Path to your GoogleFindMyTools checkout. Leave empty if collector.py lives
# inside it (the default).
GFMT_DIR=

# --- Google sign-in -----------------------------------------------------------
# Where GoogleFindMyTools keeps your Google tokens (SECRET — never commit).
# Empty = Auth/secrets.json inside this checkout. On a server, point it outside
# the repo, e.g. /etc/tagtrace/secrets.json (chmod 600).
GFMT_SECRETS_FILE=

# Chrome major version for the one-time Google login (empty = auto-detect).
CHROME_VERSION_MAIN=
